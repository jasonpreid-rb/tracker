GOOGLE_SERVICE_ACCOUNT_B64=
# ID from the Google Sheet URL: /spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Any long random string; you type it once in the dashboard to unlock it
DASHBOARD_KEY=
# Must match exactly how each property is listed in Search Console
